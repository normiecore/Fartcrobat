{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "src/engine/**/*",
    "src/features/**/*",
    "src/preload/api.d.ts",
    "src/main/util/**/*",
    "src/agent-shim/**/*",
    "tests/engine/**/*"
  ],
  "exclude": ["src/features/*/main.ts", "src/features/*/main/**/*"]
}
