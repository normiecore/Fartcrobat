{
  "name": "fartcrobat",
  "productName": "Fartcrobat",
  "version": "0.1.0",
  "description": "Free, open-source PDF reader, editor and signer for people coming from Acrobat Pro.",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Fartcrobat contributors"
  },
  "homepage": "https://github.com/normiecore/fartcrobat",
  "repository": {
    "type": "git",
    "url": "https://github.com/normiecore/fartcrobat.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "python3 scripts/make_fixtures.py",
    "e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource/allura": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "diff": "^9.0.0",
    "docx": "^9.10.0",
    "exceljs": "^4.4.0",
    "mupdf": "^1.28.1",
    "node-forge": "^1.4.0",
    "pptxgenjs": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^6.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.18.0",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xmldom/xmldom": "0.8.15",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "lucide-react": "1.55.0",
    "prettier": "^3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  },
  "desktopName": "fartcrobat.desktop"
}
