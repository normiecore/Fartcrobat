{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node",
      "electron-vite/node"
    ]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/features/*/main.ts",
    "src/features/*/main/**/*",
    "src/features/digital-signatures/lib/**/*",
    "src/agent-shim/**/*",
    "tests/e2e/**/*"
  ]
}